{
  "name": "shader-playground",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "deadcode": "knip",
    "circular": "dpdm --no-warning --no-tree --exit-code circular:1 src/main.tsx",
    "size:check": "node scripts/check-bundle-size.mjs",
    "check": "npm run typecheck && npm run lint && npm run deadcode && npm run circular && npm run test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@lezer/highlight": "^1.2.1",
    "@loaders.gl/core": "^4.4.1",
    "@loaders.gl/gltf": "^4.4.1",
    "@loaders.gl/obj": "^4.4.1",
    "@xyflow/react": "^12.10.2",
    "codemirror-lang-glsl": "^0.5.0",
    "gl-matrix": "^3.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@playwright/test": "^1.59.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.6",
    "dpdm": "4.2.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "knip": "6.12.2",
    "typescript": "~5.6.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.6"
  }
}
